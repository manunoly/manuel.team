---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero";
import About from "../components/About";
import Skills from "../components/Skills";
import Projects from "../components/Projects";
import Experience from "../components/Experience";
import Education from "../components/Education";
import BlogPreview from "../components/BlogPreview";
import Testimonials from "../components/Testimonials";
import Contact from "../components/Contact";
import Research from "../components/Research";
import portfolioData from "../data/portfolio.json";

const {
    seo,
	hero,
	about,
	skills,
	projects,
	experience,
	education,
	blog,
	testimonials,
	contact,
} = portfolioData.en;

const profiles = {
    github: contact.github,
    linkedin: contact.linkedin,
    twitter: contact.twitter,
    scholar: portfolioData.en.research.profileLink,
};
---

<Layout
	title={seo.title}
	lang="en"
	description={seo.description}
>
	<main id="main-content" tabindex="-1" class="pb-16">
		<Hero
			name={hero.name}
			tagline={hero.tagline}
			subtext={hero.subtext}
			resumeLink={hero.resumeLink}
			email={contact.email}
			profiles={profiles}
			lang="en"
		/>

		<About
			title={about.title}
			content={about.content}
			image={about.image}
			lang="en"
		/>

		<Skills skills={skills} lang="en" />

		<Projects projects={projects} lang="en" />

		<Experience experience={experience} lang="en" />

		<Education education={education} lang="en" />

		<Research data={portfolioData.en.research} lang="en" />

		<BlogPreview posts={blog} lang="en" />

		<Testimonials testimonials={testimonials} lang="en" />

		<Contact
			email={contact.email}
			profiles={profiles}
			lang="en"
		/>
	</main>
</Layout>
